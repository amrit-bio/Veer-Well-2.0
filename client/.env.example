# ============================================
# VeerWell Frontend Environment Variables
# ============================================
# Location: client/.env
# Copy this file to .env and fill in your actual values

# Supabase Project URL
VITE_SUPABASE_URL=https://krshfwuqifaxecbtrxmy.supabase.co

# Supabase Anon (public) Key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Google Gemini API Key for AI features
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here

# ============================================
# How to Get These Values:
# ============================================
#
# VITE_SUPABASE_URL & VITE_SUPABASE_ANON_KEY:
#   1. Go to https://app.supabase.com
#   2. Select project: krshfwuqifaxecbtrxmy
#   3. Click Settings → API
#   4. VITE_SUPABASE_URL = Project URL
#   5. VITE_SUPABASE_ANON_KEY = anon (public) key
#
# VITE_GEMINI_API_KEY:
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Click "Create API Key"
#   3. Copy the key value
#
