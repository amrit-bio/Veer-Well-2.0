# ============================================
# VeerWell Backend Environment Variables
# ============================================
# Location: server/.env
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to git (it's in .gitignore)

# Supabase Project URL
SUPABASE_URL=https://krshfwuqifaxecbtrxmy.supabase.co

# Supabase Service Role Secret Key (KEEP SECRET)
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# Supabase Anon (public) Key
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key_here

# Google Gemini API Key for AI features
GEMINI_API_KEY=your_google_gemini_api_key_here

# JWT Secret for signing authentication tokens
JWT_SECRET=veerwell_super_secret_jwt_key_2026

# Server port (Vercel will override this for production)
PORT=5000

# ============================================
# How to Get These Values:
# ============================================
#
# SUPABASE_URL:
#   1. Go to https://app.supabase.com
#   2. Select project: krshfwuqifaxecbtrxmy
#   3. Click Settings → API
#   4. Copy the "Project URL"
#
# SUPABASE_SECRET_KEY:
#   1. Same location (Settings → API)
#   2. Copy the "service_role (secret)" key
#   3. WARNING: This is a secret key - never share or commit to git
#
# SUPABASE_PUBLISHABLE_KEY:
#   1. Same location (Settings → API)
#   2. Copy the "anon (public)" key
#
# GEMINI_API_KEY:
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Click "Create API Key"
#   3. Copy the key value
#
# VITE_API_BASE (Frontend only):
#   - Local: http://localhost:5000
#   - Production: https://your-backend-url.railway.app
#   - This tells the React frontend where to find the API server
#
