# ============================================
# VeerWell 2.0 Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# Never commit .env file to git (it's in .gitignore)

# ============================================
# Frontend Variables (client/.env)
# ============================================
VITE_SUPABASE_URL=https://krshfwuqifaxecbtrxmy.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Backend API URL - IMPORTANT for production deployment
# Local: http://localhost:5000
# Production: https://your-backend-url.railway.app
VITE_API_BASE=http://localhost:5000

# ============================================
# Backend Variables (server/.env)
# ============================================
SUPABASE_URL=https://krshfwuqifaxecbtrxmy.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# JWT Secret for token signing
JWT_SECRET=veerwell_super_secret_jwt_key_2026

# Server port (Vercel will override this)
PORT=5000

# ============================================
# How to Get These Values:
# ============================================
# 
# SUPABASE_URL & SUPABASE_ANON_KEY:
#   1. Go to https://app.supabase.com
#   2. Select project: krshfwuqifaxecbtrxmy
#   3. Navigate to Settings → API
#   4. Copy the Project URL
#   5. Copy the "anon (public)" key
#
# SUPABASE_SECRET_KEY:
#   1. Same location as above (Settings → API)
#   2. Copy the "service_role (secret)" key
#   3. KEEP THIS SECRET - Never share or commit to git
#
# GEMINI_API_KEY:
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Click "Create API Key"
#   3. Copy the API key
#
# ============================================
